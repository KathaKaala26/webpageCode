generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PaymentMethod {
  STRIPE
  COD
}

enum OrderStatus {
  PENDING_PAYMENT // Stripe checkout started, not yet paid
  PAID            // Stripe payment confirmed
  COD_PENDING     // Cash on delivery order placed, awaiting dispatch
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  paymentMethod   PaymentMethod
  status          OrderStatus
  stripeSessionId String?       @unique
  paidAt          DateTime?

  customerName    String
  email           String
  phone           String
  addressLine1    String
  addressLine2    String?
  city            String
  region          String
  postalCode      String
  country         String
  notes           String?

  currency        String        @default("usd")
  subtotalCents   Int
  shippingCents   Int
  codFeeCents     Int           @default(0)
  totalCents      Int

  items           OrderItem[]

  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productSlug    String
  purchaseCode   String
  title          String
  image          String
  unitPriceCents Int
  quantity       Int
}

// Admin-uploaded replacement image for a product (keyed by products.ts slug).
// When absent, the product's original image (from products.ts) is used.
model ProductImage {
  slug      String   @id
  url       String
  updatedAt DateTime @updatedAt
}

// Admin-set replacement price for a product (keyed by products.ts slug).
// When absent, the product's original priceCents (from products.ts) is used.
// This is the authoritative source checkout reads from, so it's always safe.
model ProductPrice {
  slug       String   @id
  priceCents Int
  updatedAt  DateTime @updatedAt
}

// Admin-set sold-out override (keyed by products.ts slug). Absent = the
// static `available` value from products.ts.
model ProductAvailabilityOverride {
  slug      String   @id
  available Boolean
  updatedAt DateTime @updatedAt
}

enum ProductKind {
  ART_FRAME
  HOME_DECOR
}

// Admin-set classification (keyed by products.ts slug). Absent = ART_FRAME
// (today's default — no behavior changes until an admin flips a product to
// HOME_DECOR or adds sizes).
model ProductKindOverride {
  slug      String      @id
  kind      ProductKind
  updatedAt DateTime    @updatedAt
}

// Admin-added size options for Art Frame products. A product with no rows
// here shows its normal single price (no selector). Rows are kept even if
// the product is later flipped to HOME_DECOR (just not rendered), so no
// data is lost by toggling kind back and forth.
model ProductSize {
  id         String   @id @default(cuid())
  slug       String
  label      String
  priceCents Int
  updatedAt  DateTime @updatedAt

  @@unique([slug, label])
  @@index([slug])
}

// Admin-set replacement description (keyed by slug). Absent = static
// description from products.ts. An explicit empty string is a deliberate
// "blank this description" — distinct from "no override row".
model ProductDescriptionOverride {
  slug        String   @id
  description String
  updatedAt   DateTime @updatedAt
}

enum HomeSection {
  GALLERY
  PALM_LEAF
  COLORFUL
  ADDITIONAL
}

// Admin-controlled Home page section membership + order. No rows for a
// section = fall back to the site's hardcoded defaults, so the Home page
// never renders an empty section before an admin configures anything.
model HomeSectionItem {
  slug      String
  section   HomeSection
  position  Int         @default(0)
  updatedAt DateTime    @updatedAt

  @@id([slug, section])
  @@index([section])
}

// Admin-set USD -> GBP conversion rate used to charge UK orders in GBP at
// checkout. Singleton row (id always 1).
model ExchangeRate {
  id        Int      @id @default(1)
  usdToGbp  Float
  updatedAt DateTime @updatedAt
}

// Messages left through the chat assistant ("leave us a message"),
// replacing the Wix Chat inbox.
model Enquiry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String
  email     String
  message   String
  page      String?
  handled   Boolean  @default(false)

  @@index([createdAt])
}
