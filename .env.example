# ── Site ──────────────────────────────────────────────────────────
# Public URL of the deployed site (used for Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (Supabase Postgres) ──────────────────────────────────
# Supabase → Project Settings → Database → Connection string
# Pooled connection (port 6543) for the app:
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) for `prisma db push`:
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── Stripe ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe Dashboard → Developers → Webhooks → endpoint: /api/webhooks/stripe
# event: checkout.session.completed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Admin (orders + chat enquiries at /admin) ─────────────────────
ADMIN_PASSWORD=change-me
# Any long random string, used to sign the admin cookie
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# ── Chat assistant hand-off (optional) ────────────────────────────
# WhatsApp number in international format, digits only, e.g. 16125550123
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Enquiry email notifications (optional) ────────────────────────
# Sends an email whenever the Contact form or chat widget's "leave a
# message" is submitted. Needs a Gmail App Password, not the regular
# account password: myaccount.google.com → Security → 2-Step Verification
# (turn on if needed) → App passwords → generate one for "Mail". Without
# these two set, enquiries still save to the database — they just won't
# email anyone.
GMAIL_USER=yourbusiness@gmail.com
GMAIL_APP_PASSWORD=your-16-letter-app-password
# Where notifications are sent. Defaults to GMAIL_USER if unset.
CONTACT_NOTIFY_EMAIL=yourbusiness@gmail.com

# ── Supabase Storage (admin product image uploads) ────────────────
# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://xxxx.supabase.co
# Supabase → Project Settings → API Keys → service_role secret
# Full-access key — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...
